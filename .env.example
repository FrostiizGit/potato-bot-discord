# From https://discord.com/developers/applications -> your app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Your private server's ID (right-click the server with Developer Mode on -> Copy Server ID)
DISCORD_GUILD_ID=

# Local: stalagmite db create local potato-local --engine postgres --memory 256
#        stalagmite db url local potato-local
# Server: set automatically by `stalagmite db link <server> potato-db potato-bot`
DATABASE_URL=

# debug | info | warn | error (default info)
LOG_LEVEL=info

# Health check server (GET /health), used by Stalagmite deploys
PORT=3000

# Optional. YouTube blocks most VPS/datacenter IPs ("Sign in to confirm you're not a bot").
# Export youtube.com cookies (see README) and set the base64 of the file: base64 -i cookies.txt
YOUTUBE_COOKIES=
